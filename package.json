{
  "name": "tefas-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && bun run test:node",
    "test:node": "node --test tests/parser.test.js tests/transport.test.js tests/retry.test.js tests/client.test.js",
    "test:bun": "bun test ./tests",
    "check": "bun run typecheck && bun run build && bun run test:node && bun run test:bun",
    "verify:package": "bun run check && node scripts/verify-package.mjs",
    "prepublishOnly": "bun run verify:package"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
